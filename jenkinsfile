pipeline {
    agent any

    environment {
        IMAGE_NAME   = 'zerotrust-app'
        OLLAMA_URL   = 'http://ollama:11434'
        OLLAMA_MODEL = 'llama3.2:3b'
        REPORTS_DIR  = 'reports'
        VENV         = '/opt/zerotrust-venv'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('0. Préparation') {
    steps {
        sh '''
            # Assurer l'existence du cache apt
            mkdir -p /var/cache/apt/archives/partial

            # Python
            if ! command -v python3 &>/dev/null; then
                apt-get update -qq && apt-get install -y --no-install-recommends python3 python3-pip python3-venv
            fi

            # Trivy via apt (vérification GPG avant installation)
            if ! command -v trivy &>/dev/null; then
                apt-get update -qq
                apt-get install -y --no-install-recommends wget apt-transport-https gnupg
                wget -qO /tmp/trivy.gpg \
                    https://aquasecurity.github.io/trivy-repo/deb/public.key
                # Valider que la clé téléchargée est un fichier GPG non vide
                if [ ! -s /tmp/trivy.gpg ]; then
                    echo "ERREUR: clé GPG Trivy vide ou invalide" && exit 1
                fi
                gpg --no-default-keyring --keyring /tmp/trivy-check.gpg \
                    --import /tmp/trivy.gpg 2>/dev/null || true
                echo "Trivy GPG key info:"
                gpg --no-default-keyring --keyring /tmp/trivy-check.gpg \
                    --fingerprint 2>/dev/null || true
                cp /tmp/trivy.gpg /etc/apt/keyrings/trivy.gpg
                echo "deb [signed-by=/etc/apt/keyrings/trivy.gpg] \
                    https://aquasecurity.github.io/trivy-repo/deb generic main" \
                    > /etc/apt/sources.list.d/trivy.list
                apt-get update -qq
                apt-get install -y --no-install-recommends trivy
            fi

            # Docker CLI
            if ! command -v docker &>/dev/null; then
                apt-get update -qq
                apt-get install -y --no-install-recommends docker.io
            fi

            mkdir -p ${REPORTS_DIR}
            python3 -m venv ${VENV}
            ${VENV}/bin/pip install --quiet semgrep anthropic rich requests pydantic
            # Rendre docker accessible dans tous les sh steps suivants
            [ -f /usr/bin/docker ] && ln -sf /usr/bin/docker /usr/local/bin/docker || true
            docker --version || echo "ATTENTION: Docker CLI non disponible"
            echo '=== Vérification moteurs IA ==='
            ${VENV}/bin/python3 agent/ollama_client.py
        '''
    }
}

        stage('1. SAST - Semgrep') {
            steps {
                sh '''
                    ${VENV}/bin/semgrep --config=auto test-app/ \
                        --json --output=${REPORTS_DIR}/semgrep-results.json \
                        --severity=WARNING || true
                '''
                sh '''
                    ${VENV}/bin/python3 -c "
import json
try:
    d = json.load(open('${REPORTS_DIR}/semgrep-results.json'))
    n = len(d.get('results', []))
    print(f'Semgrep : {n} probleme(s) detecte(s)')
except Exception as e:
    print(f'Semgrep rapport vide : {e}')
"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: "${REPORTS_DIR}/semgrep-results.json",
                                     allowEmptyArchive: true
                }
            }
        }

        stage('2. SCA - Trivy') {
            steps {
                sh '''
                    trivy fs ./test-app --format json \
                        --output ${REPORTS_DIR}/trivy-report.json \
                        --severity MEDIUM,HIGH,CRITICAL --quiet || true
                '''
                sh '''
                    ${VENV}/bin/python3 -c "
import json
try:
    d = json.load(open('${REPORTS_DIR}/trivy-report.json'))
    t = sum(len(r.get('Vulnerabilities') or []) for r in d.get('Results', []))
    c = sum(1 for r in d.get('Results', []) for v in (r.get('Vulnerabilities') or []) if v.get('Severity') == 'CRITICAL')
    h = sum(1 for r in d.get('Results', []) for v in (r.get('Vulnerabilities') or []) if v.get('Severity') == 'HIGH')
    print(f'Trivy : {t} CVE total | {c} CRITICAL | {h} HIGH')
except Exception as e:
    print(f'Trivy rapport vide : {e}')
"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: "${REPORTS_DIR}/trivy-report.json",
                                     allowEmptyArchive: true
                }
            }
        }

        stage('3. AI Security Guard') {
            stages {
                stage('3a. Anti-Tampering') {
                    steps {
                        sh 'cp ${REPORTS_DIR}/trivy-report.json agent/ || true'
                        sh 'cp ${REPORTS_DIR}/semgrep-results.json agent/ || true'
                        withCredentials([string(credentialsId: 'ANTHROPIC_API_KEY', variable: 'ANTHROPIC_API_KEY')]) {
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                                sh 'cd agent && PIPELINE_PATH=${WORKSPACE}/jenkinsfile ${VENV}/bin/python3 antitamper_agent.py'
                            }
                        }
                    }
                }
                stage('3b. Remédiation CVE') {
                    steps {
                        withCredentials([string(credentialsId: 'ANTHROPIC_API_KEY', variable: 'ANTHROPIC_API_KEY')]) {
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                                sh 'cd agent && ${VENV}/bin/python3 remediation_agent.py'
                            }
                        }
                    }
                }
                stage('3c. Rapport Explicatif') {
                    steps {
                        withCredentials([string(credentialsId: 'ANTHROPIC_API_KEY', variable: 'ANTHROPIC_API_KEY')]) {
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                                sh 'cd agent && ${VENV}/bin/python3 explainer_agent.py'
                            }
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'agent/*.json,agent/*.md',
                                     allowEmptyArchive: true
                }
            }
        }

        stage('4. Build Docker') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .'
            }
        }

        stage('5. Scan Image Docker') {
            steps {
                sh 'trivy image --severity CRITICAL --exit-code 0 ${IMAGE_NAME}:${BUILD_NUMBER}'
            }
        }

        stage('6. Signature Cosign') {
            steps {
                sh '''
                    if ! command -v cosign &>/dev/null; then
                        curl -sSfL https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64 \
                            -o /usr/local/bin/cosign && chmod +x /usr/local/bin/cosign
                    fi
                    cosign version
                    # Signature keyless OIDC (mode zero-trust, sans clé statique)
                    COSIGN_EXPERIMENTAL=1 cosign sign --yes \
                        ${IMAGE_NAME}:${BUILD_NUMBER} 2>/dev/null || \
                        echo "INFO: Signature keyless ignorée hors OIDC — image construite et vérifiée localement"
                    echo "Pipeline Zero Trust complet - Build ${BUILD_NUMBER}"
                '''
            }
        }

    } // end stages
// hafssa jihad hhhhh
    post {
        always  { deleteDir() }
        success { echo 'Pipeline Zero Trust OK' }
        failure { echo 'Echec — voir les artifacts' }
    }

} // end pipeline