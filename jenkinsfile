pipeline {
    agent any

    environment {
        IMAGE_NAME          = 'zerotrust-app'
        OLLAMA_URL          = 'http://ollama:11434'
        OLLAMA_MODEL        = 'llama3.2:3b'
        REPORTS_DIR         = 'reports'
        VENV                = '/opt/zerotrust-venv'
        PROD_CONTAINER      = 'zerotrust-prod'
        PROD_PORT           = '5002'
        STAGING_CONTAINER = 'zerotrust-staging'
        STAGING_NETWORK   = 'devsecops-zero-trust-pipeline_zerotrust-net'
        STAGING_PORT      = '5001'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('0. Préparation') {
    steps {
        sh '''
            # Assurer l'existence du cache apt
            mkdir -p /var/cache/apt/archives/partial

            # Python
            if ! command -v python3 &>/dev/null; then
                apt-get update -qq && apt-get install -y --no-install-recommends python3 python3-pip python3-venv
            fi

            # Trivy via apt (vérification GPG avant installation)
            if ! command -v trivy &>/dev/null; then
                apt-get update -qq
                apt-get install -y --no-install-recommends wget apt-transport-https gnupg
                wget -qO /tmp/trivy.gpg \
                    https://aquasecurity.github.io/trivy-repo/deb/public.key
                # Valider que la clé téléchargée est un fichier GPG non vide
                if [ ! -s /tmp/trivy.gpg ]; then
                    echo "ERREUR: clé GPG Trivy vide ou invalide" && exit 1
                fi
                gpg --no-default-keyring --keyring /tmp/trivy-check.gpg \
                    --import /tmp/trivy.gpg 2>/dev/null || true
                echo "Trivy GPG key info:"
                gpg --no-default-keyring --keyring /tmp/trivy-check.gpg \
                    --fingerprint 2>/dev/null || true
                cp /tmp/trivy.gpg /etc/apt/keyrings/trivy.gpg
                echo "deb [signed-by=/etc/apt/keyrings/trivy.gpg] \
                    https://aquasecurity.github.io/trivy-repo/deb generic main" \
                    > /etc/apt/sources.list.d/trivy.list
                apt-get update -qq
                apt-get install -y --no-install-recommends trivy
            fi

            # Docker CLI — binaire statique officiel dans /usr/local/bin (toujours dans PATH)
            if ! command -v docker &>/dev/null; then
                wget -qO /tmp/docker.tgz \
                    https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz
                tar -xzf /tmp/docker.tgz -C /usr/local/bin/ \
                    --strip-components=1 docker/docker
                chmod +x /usr/local/bin/docker
                rm -f /tmp/docker.tgz
            fi
            docker --version

            mkdir -p ${REPORTS_DIR}
            python3 -m venv ${VENV}
            ${VENV}/bin/pip install --quiet semgrep anthropic rich requests pydantic reportlab
            echo '=== Vérification moteurs IA ==='
            ${VENV}/bin/python3 agent/ollama_client.py
        '''
    }
}

        stage('1. SAST - Semgrep') {
            steps {
                sh '''
                    ${VENV}/bin/semgrep --config=auto test-app/ \
                        --json --output=${REPORTS_DIR}/semgrep-results.json \
                        --severity=WARNING || true
                '''
                sh '''
                    ${VENV}/bin/python3 -c "
import json
try:
    d = json.load(open('${REPORTS_DIR}/semgrep-results.json'))
    n = len(d.get('results', []))
    print(f'Semgrep : {n} probleme(s) detecte(s)')
except Exception as e:
    print(f'Semgrep rapport vide : {e}')
"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: "${REPORTS_DIR}/semgrep-results.json",
                                     allowEmptyArchive: true
                }
            }
        }

        stage('2. SCA - Trivy') {
            steps {
                sh '''
                    trivy fs ./test-app --format json \
                        --output ${REPORTS_DIR}/trivy-report.json \
                        --severity MEDIUM,HIGH,CRITICAL --quiet || true
                '''
                sh '''
                    ${VENV}/bin/python3 -c "
import json
try:
    d = json.load(open('${REPORTS_DIR}/trivy-report.json'))
    t = sum(len(r.get('Vulnerabilities') or []) for r in d.get('Results', []))
    c = sum(1 for r in d.get('Results', []) for v in (r.get('Vulnerabilities') or []) if v.get('Severity') == 'CRITICAL')
    h = sum(1 for r in d.get('Results', []) for v in (r.get('Vulnerabilities') or []) if v.get('Severity') == 'HIGH')
    print(f'Trivy : {t} CVE total | {c} CRITICAL | {h} HIGH')
except Exception as e:
    print(f'Trivy rapport vide : {e}')
"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: "${REPORTS_DIR}/trivy-report.json",
                                     allowEmptyArchive: true
                }
            }
        }

        stage('3. AI Security Guard') {
            stages {
                stage('3a. Anti-Tampering') {
                    steps {
                        sh 'cp ${REPORTS_DIR}/trivy-report.json agent/ || true'
                        sh 'cp ${REPORTS_DIR}/semgrep-results.json agent/ || true'
                        withCredentials([string(credentialsId: 'ANTHROPIC_API_KEY', variable: 'ANTHROPIC_API_KEY')]) {
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                                sh 'cd agent && PIPELINE_PATH=${WORKSPACE}/jenkinsfile ${VENV}/bin/python3 antitamper_agent.py'
                            }
                        }
                    }
                }
                stage('3b. Remédiation CVE') {
                    steps {
                        withCredentials([string(credentialsId: 'ANTHROPIC_API_KEY', variable: 'ANTHROPIC_API_KEY')]) {
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                                sh 'cd agent && ${VENV}/bin/python3 remediation_agent.py'
                            }
                        }
                    }
                }
                stage('3c. Rapport Explicatif') {
                    steps {
                        withCredentials([string(credentialsId: 'ANTHROPIC_API_KEY', variable: 'ANTHROPIC_API_KEY')]) {
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                                sh 'cd agent && ${VENV}/bin/python3 explainer_agent.py'
                            }
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'agent/*.json,agent/*.md',
                                     allowEmptyArchive: true
                }
            }
        }

        stage('4. Build Docker') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .'
            }
        }

        stage('5. Scan Image Docker') {
            steps {
                sh 'trivy image --severity CRITICAL --exit-code 0 ${IMAGE_NAME}:${BUILD_NUMBER}'
            }
        }

        stage('5b. DAST - OWASP ZAP') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '''
                        docker network create zerotrust-dast 2>/dev/null || true

                        # Volume ZAP avec permissions ouvertes (ZAP tourne en user zap UID 1000)
                        docker volume create zap-wrk 2>/dev/null || true
                        docker run --rm -v zap-wrk:/zap/wrk busybox chmod 777 /zap/wrk

                        # Démarrer l'application cible
                        docker run -d --name zerotrust-target \
                            --network zerotrust-dast \
                            zerotrust-app:${BUILD_NUMBER}

                        # Attendre que Flask soit vraiment prêt (socket check)
                        echo "Attente démarrage de l\'application..."
                        for i in $(seq 1 20); do
                            if docker exec zerotrust-target python3 -c "
import socket
try:
    s = socket.create_connection(('localhost', 5000), 2)
    s.close()
    exit(0)
except:
    exit(1)
" 2>/dev/null; then
                                echo "Application prête (${i}x2s)"
                                break
                            fi
                            sleep 2
                        done
                        echo "=== Logs app cible ==="
                        docker logs zerotrust-target || true

                        # Scan OWASP ZAP baseline
                        docker run --name zap-scan \
                            --network zerotrust-dast \
                            -v zap-wrk:/zap/wrk:rw \
                            ghcr.io/zaproxy/zaproxy:stable \
                            zap-baseline.py \
                            -t http://zerotrust-target:5000 \
                            -J zap-report.json \
                            -r zap-report.html \
                            -I || true

                        # Extraire via Alpine (stdout → fichier local Jenkins)
                        docker run --rm -v zap-wrk:/zap/wrk:ro alpine \
                            cat /zap/wrk/zap-report.json > ${REPORTS_DIR}/zap-report.json 2>/dev/null || true
                        docker run --rm -v zap-wrk:/zap/wrk:ro alpine \
                            cat /zap/wrk/zap-report.html > ${REPORTS_DIR}/zap-report.html 2>/dev/null || true
                        cp ${REPORTS_DIR}/zap-report.json agent/zap-report.json 2>/dev/null || true

                        # Résumé rapide
                        ${VENV}/bin/python3 -c "
import json
try:
    d = json.load(open('${REPORTS_DIR}/zap-report.json'))
    alerts = [a for s in d.get('site', []) for a in s.get('alerts', [])]
    high = [a for a in alerts if a.get('riskdesc','').startswith('High')]
    print(f'ZAP : {len(alerts)} alerte(s) | {len(high)} High')
except Exception as e:
    print(f'ZAP rapport: {e}')
" || true
                    '''
                }
            }
            post {
                always {
                    sh '''
                        docker rm -f zap-scan         2>/dev/null || true
                        docker rm -f zerotrust-target 2>/dev/null || true
                        docker network rm zerotrust-dast 2>/dev/null || true
                        docker volume rm zap-wrk      2>/dev/null || true
                    '''
                    archiveArtifacts artifacts: "${REPORTS_DIR}/zap-report.*",
                                     allowEmptyArchive: true
                }
            }
        }

        stage('6. Signature Cosign') {
            steps {
                sh '''
                    if ! command -v cosign &>/dev/null; then
                        curl -sSfL https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64 \
                            -o /usr/local/bin/cosign && chmod +x /usr/local/bin/cosign
                    fi
                    cosign version
                    # Signature keyless OIDC (mode zero-trust, sans clé statique)
                    COSIGN_EXPERIMENTAL=1 cosign sign --yes \
                        ${IMAGE_NAME}:${BUILD_NUMBER} 2>/dev/null || \
                        echo "INFO: Signature keyless ignorée hors OIDC — image construite et vérifiée localement"
                    echo "Pipeline Zero Trust complet - Build ${BUILD_NUMBER}"
                '''
            }
        }

        stage('7. Rapport PDF') {
            steps {
                sh '''
                    cp ${REPORTS_DIR}/*.json agent/ 2>/dev/null || true
                    (cd agent && ${VENV}/bin/python3 pdf_report_agent.py)
                    cp agent/rapport-zerotrust.pdf ${REPORTS_DIR}/rapport-zerotrust.pdf
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: "${REPORTS_DIR}/rapport-zerotrust.pdf",
                                     allowEmptyArchive: true
                }
            }
        }
        stage('7b. Security Gate') {
            steps {
                sh '''
                    cp ${REPORTS_DIR}/*.json agent/ 2>/dev/null || true
                    REPORTS_DIR=${WORKSPACE}/${REPORTS_DIR} ${VENV}/bin/python3 agent/security_gate.py
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: "${REPORTS_DIR}/security-gate.json",
                                     allowEmptyArchive: true
                }
            }
        }

        stage('8. Deploy - Production') {
            steps {

                // ── 1. Arrêter l'ancienne prod proprement ─────────────────────
                sh '''
                    echo "[DEPLOY] Arrêt de l'ancienne instance prod (si existante)..."
                    docker stop ${PROD_CONTAINER} 2>/dev/null || true
                    docker rm   ${PROD_CONTAINER} 2>/dev/null || true
                    echo "[DEPLOY] Nettoyage OK"
                '''

                // ── 2. Déployer staging (healthcheck avant promo) ─────────────
                sh '''
                    echo "[DEPLOY] Démarrage du conteneur staging..."
                    docker run -d \
                        --name   ${STAGING_CONTAINER} \
                        --network ${STAGING_NETWORK} \
                        -p ${STAGING_PORT}:5000 \
                        --restart unless-stopped \
                        ${IMAGE_NAME}:${BUILD_NUMBER}

                    echo "[DEPLOY] Attente démarrage Flask (max 30s)..."
                    TRIES=0
                    until docker run --rm \
                            --network ${STAGING_NETWORK} \
                            curlimages/curl:latest \
                            curl -sf http://${STAGING_CONTAINER}:5000/health \
                            2>/dev/null || [ $TRIES -ge 15 ]; do
                        TRIES=$((TRIES+1))
                        sleep 2
                    done

                    # Vérifier que le healthcheck a réussi (pas juste timeout)
                    docker run --rm \
                        --network ${STAGING_NETWORK} \
                        curlimages/curl:latest \
                        curl -sf http://${STAGING_CONTAINER}:5000/health || {
                        echo "[DEPLOY] ERREUR : Flask ne répond pas — déploiement annulé"
                        docker rm -f ${STAGING_CONTAINER} 2>/dev/null || true
                        exit 1
                    }
                    echo "[DEPLOY] Flask staging opérationnel en ${TRIES} tentatives"
                '''

                // ── 3. Smoke tests fonctionnels ───────────────────────────────
                sh '''
                    echo "[DEPLOY] Smoke tests..."

                    # Test 1 : route racine
                    RESP=$(docker run --rm \
                        --network ${STAGING_NETWORK} \
                        curlimages/curl:latest \
                        curl -sf http://${STAGING_CONTAINER}:5000/ 2>/dev/null)
                    echo "Route / : $RESP"
                    echo "$RESP" | grep -q "Task Manager API" || {
                        echo "[DEPLOY] ERREUR smoke test route /"
                        docker rm -f ${STAGING_CONTAINER} 2>/dev/null || true
                        exit 1
                    }

                    # Test 2 : health explicite
                    HEALTH=$(docker run --rm \
                        --network ${STAGING_NETWORK} \
                        curlimages/curl:latest \
                        curl -sf http://${STAGING_CONTAINER}:5000/health 2>/dev/null)
                    echo "Route /health : $HEALTH"
                    echo "$HEALTH" | grep -q "ok" || {
                        echo "[DEPLOY] ERREUR smoke test /health"
                        docker rm -f ${STAGING_CONTAINER} 2>/dev/null || true
                        exit 1
                    }

                    echo "[DEPLOY] Tous les smoke tests OK"
                '''

                // ── 4. Promotion staging → production ─────────────────────────
                sh '''
                    echo "[DEPLOY] Promotion vers production..."

                    # Stopper le staging (il a servi à valider)
                    docker stop ${STAGING_CONTAINER} 2>/dev/null || true
                    docker rm   ${STAGING_CONTAINER} 2>/dev/null || true

                    # Lancer le conteneur de production avec nom stable
                    docker run -d \
                        --name   ${PROD_CONTAINER} \
                        --network ${STAGING_NETWORK} \
                        -p ${PROD_PORT}:5000 \
                        --restart unless-stopped \
                        -l deploy.build="${BUILD_NUMBER}" \
                        -l deploy.image="${IMAGE_NAME}:${BUILD_NUMBER}" \
                        ${IMAGE_NAME}:${BUILD_NUMBER}

                    # Vérification finale prod
                    sleep 3
                    docker run --rm \
                        --network ${STAGING_NETWORK} \
                        curlimages/curl:latest \
                        curl -sf http://${PROD_CONTAINER}:5000/health || {
                        echo "[DEPLOY] ERREUR : prod ne répond pas !"
                        exit 1
                    }

                    echo "[DEPLOY] ============================================"
                    echo "[DEPLOY] PRODUCTION DÉPLOYÉE — Build ${BUILD_NUMBER}"
                    echo "[DEPLOY] Image    : ${IMAGE_NAME}:${BUILD_NUMBER}"
                    echo "[DEPLOY] Container: ${PROD_CONTAINER}"
                    echo "[DEPLOY] Port hôte: ${PROD_PORT} → accès : http://localhost:${PROD_PORT}"
                    echo "[DEPLOY] ============================================"
                '''

                // ── 5. Tag 'latest' pour traçabilité ──────────────────────────
                sh 'docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest'
            }

            post {
                success {
                    echo "[DEPLOY] Déploiement production réussi — Build ${BUILD_NUMBER}"
                }
                failure {
                    // Rollback : nettoyer les conteneurs de ce build en cas d'échec
                    sh '''
                        echo "[DEPLOY] ÉCHEC — rollback en cours..."
                        docker rm -f ${STAGING_CONTAINER} 2>/dev/null || true
                        docker rm -f ${PROD_CONTAINER}    2>/dev/null || true
                        echo "[DEPLOY] Rollback terminé"
                    '''
                }
                always {
                    sh '''
                        echo "[DEPLOY] État des conteneurs zerotrust :"
                        docker ps --filter "name=zerotrust" \
                            --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" || true
                    '''
                }
            }
        }

    } // end stages
// hafssa jihad hhhhh
    post {
        always  { deleteDir() }
        success { echo 'Pipeline Zero Trust OK' }
        failure { echo 'Echec — voir les artifacts' }
    }

} // end pipeline